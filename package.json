{
  "name": "gdrive-rescue-vault",
  "version": "1.0.0",
  "description": "Always Free Blue Team & Incident Response Google Drive File Vault on Cloudflare Workers & Pages",
  "type": "module",
  "packageManager": "pnpm@11.12.0",
  "scripts": {
    "dev": "wrangler dev",
    "dev:pages": "wrangler pages dev public",
    "deploy": "pnpm run deploy:api && pnpm run deploy:frontend",
    "deploy:api": "wrangler deploy",
    "deploy:frontend": "wrangler pages deploy public --project-name gdrive-frontend",
    "auth:token": "node scripts/get-refresh-token.js",
    "get-token": "node scripts/get-refresh-token.js",
    "decrypt": "node scripts/decrypt-tool.js",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "wrangler": "^4.147.0"
  }
}
